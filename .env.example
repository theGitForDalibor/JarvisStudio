# ============================================================
# Jarvis Studio - Environment Configuration Template
# ============================================================

# --- Environment & Server ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=true

# --- LLM Default Provider ---
# Options: openai, deepseek, gemini, anthropic, ollama, custom
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o-mini
DEFAULT_TEMPERATURE=0.2

# --- Provider Credentials & Endpoints ---
# 1. OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. DeepSeek (OpenAI-compatible)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# 3. Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-pro

# 4. Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-3-5-sonnet-20240620

# 5. Ollama / Local Model
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=llama3.1:8b

# --- Storage & Checkpoints ---
# Checkpoint backend: sqlite | memory
CHECKPOINT_BACKEND=sqlite
SQLITE_DB_PATH=data/jarvis_studio.db
WORKSPACE_ROOT=./data/workspace

# --- Human-In-The-Loop (HITL) ---
# When true, tools marked dangerous (shell, file write, external mutate) require user confirmation
HITL_ENABLED=true
HITL_AUTO_APPROVE_READ_ONLY=true

# --- Tracing & Observability ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jarvis-studio

# --- MCP Configuration ---
MCP_CONFIG_PATH=config/mcp_servers.json
